{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "स्यस्यः धुकू",
  "version": "0.1.0",
  "identifier": "com.afno.billing",
  "build": {
    "frontendDist": "../../billing/dist",
    "beforeDevCommand": "pnpm --dir ../billing dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../billing build"
  },
  "app": {
    "windows": [
      {
        "title": "स्यस्यः धुकू",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
